<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lien de partage d'une source (voir shareFeed/feedDeepLink dans
                 index.html) : schéma personnalisé, pas des App Links https —
                 pas d'assetlinks.json à signer et héberger. Hors de cette app,
                 swipernews:// ne mène nulle part, ce qui est voulu ; c'est pour
                 ça qu'il n'est jamais partagé tel quel (aucune appli de
                 messagerie ne le reconnaît comme lien) mais via le sas
                 https://news.lielu.eu/add.html, qui y rebondit — voir add.html.
                 Relayé côté web par @capacitor/app (appUrlOpen), voir
                 handleDeepLink. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="swipernews" android:host="add" />
            </intent-filter>
        </activity>

        <!-- Navigateur intégré : ouvert par-dessus le fil (pas de LAUNCHER, pas
             d'export — seule l'app peut le lancer). configChanges reprend celui
             de MainActivity pour qu'une rotation ne recharge pas l'article. -->
        <activity
            android:name=".InAppBrowserActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:theme="@style/AppTheme.Reader"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notification « de nouveaux articles » (NewsCheckWorker) : ignorée par le
         système avant Android 13, où poster une notification ne demandait
         encore aucune permission — la déclarer ici ne change rien pour ces
         versions, c'est là qu'elle devient obligatoire. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bouton « Exclure de l'optimisation de batterie » des réglages notifs
         (InAppBrowserPlugin.requestIgnoreBatteryOptimizations) : seul levier
         qui rend NewsCheckWorker vraiment fiable en arrière-plan, Doze
         retardant sinon un WorkManager périodique quelle que soit sa cadence. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
