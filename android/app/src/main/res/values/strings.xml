<resources>
    <string name="app_name">SwiperNews</string>
    <string name="title_activity_main">SwiperNews</string>
    <string name="package_name">eu.lielu.news</string>
    <string name="custom_url_scheme">eu.lielu.news</string>

    <!-- Feuille de partage du système (InAppBrowserPlugin.share) -->
    <string name="share_chooser">Partager l\'article</string>

    <!-- Navigateur intégré (InAppBrowserActivity) -->
    <string name="reader_close">Fermer l\'article</string>
    <string name="reader_share">Partager</string>
    <string name="reader_external">Ouvrir dans le navigateur</string>
    <string name="reader_readmode">Mode lecture</string>
    <string name="reader_read_ko">Cet article n\'a pas pu être simplifié</string>
    <string name="reader_read_auth">Page de connexion : affichée telle quelle</string>
    <string name="reader_retry">Réessayer</string>
    <string name="reader_error">Page indisponible</string>
    <string name="reader_error_sub">Le site n\'a pas répondu. Vérifie ta connexion, ou ouvre l\'article dans ton navigateur.</string>
    <string name="reader_no_app">Aucune application pour ouvrir ce lien</string>

    <!-- Vérification en arrière-plan (NewsCheckWorker). Le nom/la description du
         canal restent sobres : c'est ce qu'Android affiche dans SES PROPRES
         réglages système, pas dans la notification elle-même. -->
    <string name="notif_channel_name">Nouveaux articles</string>
    <string name="notif_channel_desc">Alerte quand une source suivie publie du nouveau contenu</string>

    <!-- Titre et corps de la notification : un tirage au sort à chaque envoi
         (voir NewsCheckWorker.postNotification), pour que « De nouveaux
         articles » ne revienne pas identique à chaque réveil pendant des mois —
         cosmétique seulement, aucune variante ne change ce qui est annoncé.
         Les tableaux de corps doivent rester du MÊME FORMAT (%1$s ou %1$d,
         plus %2$s pour les variantes « titled ») que leur cas : one = une
         source nommée, many = un compte, titled = le titre du premier
         article neuf trouvé (voir clampTitle) est disponible en plus. -->
    <string-array name="notif_titles">
        <item>📰 Ça vient de tomber</item>
        <item>👀 Y\'a du neuf sur ton fil</item>
        <item>✨ Une pause lecture ?</item>
        <item>🗞️ Fraîchement publié</item>
    </string-array>
    <!-- Repli SANS titre (flux malformé, <title> absent de l'item) — voir
         hasTitle dans postNotification. -->
    <string-array name="notif_bodies_one">
        <item>%1$s vient de publier — de quoi faire une pause</item>
        <item>Nouvel article chez %1$s, juste pour toi</item>
        <item>%1$s a publié quelque chose de neuf à découvrir</item>
        <item>Un nouvel article de %1$s t\'attend</item>
    </string-array>
    <string-array name="notif_bodies_many">
        <item>%1$d sources ont publié du nouveau contenu — de quoi papillonner</item>
        <item>%1$d nouveautés à glisser tout à l\'heure</item>
        <item>%1$d sources se sont réveillées : de la lecture fraîche</item>
        <item>%1$d nouveaux articles à swiper</item>
    </string-array>
    <!-- Variantes AVEC titre (%2$s), utilisées dès que le flux en fournit un —
         le cas courant : disent QUOI lire, pas seulement COMBIEN ou OÙ. -->
    <string-array name="notif_bodies_one_titled">
        <item>%1$s : « %2$s »</item>
        <item>%1$s vient de publier « %2$s »</item>
        <item>Chez %1$s : « %2$s »</item>
        <item>Nouvel article de %1$s — « %2$s »</item>
    </string-array>
    <string-array name="notif_bodies_many_titled">
        <item>%1$d nouveautés, dont « %2$s »</item>
        <item>%1$d sources se sont réveillées, à commencer par « %2$s »</item>
        <item>%1$d nouveaux articles à swiper, dont « %2$s »</item>
        <item>%1$d nouveautés — la dernière : « %2$s »</item>
    </string-array>

    <!-- Résumé local (ReaderSummary) : une petite IA qui tourne sur le téléphone. -->
    <string name="summary_fab">Résumer l\'article</string>
    <string name="summary_title">Résumé</string>
    <string name="summary_close">Fermer le résumé</string>
    <string name="summary_note_local">Écrit sur ton téléphone : l\'article ne part nulle part.</string>
    <string name="summary_note_part">Partie %1$d sur %2$d en cours d\'écriture…</string>
    <string name="summary_note_prepare">Préparation du résumé…</string>
    <string name="summary_note_copy">Copie du fichier…</string>
    <string name="summary_need_model">Le résumé est écrit par une petite IA qui tourne sur ton téléphone. Il faut d\'abord récupérer son fichier, une seule fois. Le téléchargement est la seule connexion : ensuite, tout reste sur l\'appareil. Mieux vaut le Wi‑Fi. Modèles LFM2 de Liquid AI (licence LFM 1.0 : libre, sauf usage commercial au-delà de 10 M$ de chiffre d\'affaires).</string>
    <string name="summary_download">Télécharger %1$s · %2$s</string>
    <string name="summary_download_resume">Reprendre %1$s · %2$s (%3$d %%)</string>
    <string name="summary_import">Importer un fichier GGUF…</string>
    <string name="summary_downloading">Téléchargement de %1$s…</string>
    <string name="summary_progress">Téléchargement… %1$d %%</string>
    <string name="summary_cancel_download">Annuler (reprise possible)</string>
    <string name="summary_stop">Arrêter</string>
    <string name="summary_close_btn">Fermer</string>
    <string name="summary_retry">Réessayer</string>
    <string name="summary_delete_model">Supprimer le modèle (libère la place)</string>
    <string name="summary_ready">Modèle prêt : touche le bouton ✨ pour résumer</string>
    <string name="summary_err_space">Pas assez de place sur le téléphone pour ce modèle.</string>
    <string name="summary_err_net">Téléchargement interrompu. Réessaie : il reprendra là où il s\'est arrêté.</string>
    <string name="summary_err_invalid">Fichier incomplet, altéré ou qui n\'est pas un modèle GGUF.</string>
    <string name="summary_err_load">Le modèle n\'a pas pu être chargé (mémoire insuffisante ?). Essaie le modèle léger.</string>
