<?xml version="1.0" encoding="utf-8"?>
<!-- Couleurs du navigateur intégré : exactement les variables CSS du fil
     déclarées dans :root (index.html) — fond, encre, texte discret, accents. -->
<resources>
    <color name="reader_bg">#0A0A0F</color>
    <color name="reader_bar">#0D0D13</color>
    <color name="reader_ink">#F5F3EF</color>
    <color name="reader_muted">#8A8A99</color>
    <color name="reader_accent">#FF3B6B</color>
    <color name="reader_accent2">#4AD9FF</color>
    <!-- Fonds clairs du mode lecture, identiques au « bg » des thèmes sépia et
         clair de res/raw/reader_read.js : la WebView les porte avant le premier
         rendu, faute de quoi le fond sombre apparaît une fraction de seconde. -->
    <color name="reader_page_sepia">#F3EBDC</color>
    <color name="reader_page_light">#FCFBF9</color>
</resources>
