<?xml version="1.0" encoding="utf-8"?>
<!-- Navigateur intégré (InAppBrowserActivity). Habillage volontairement sobre :
     une barre fine reprenant les couleurs du fil, le trait de progression
     bicolore de l'app, et rien d'autre — surtout pas de barre d'URL.

     La barre FLOTTE au-dessus de la WebView (FrameLayout, et non plus une
     colonne) : c'est ce qui lui permet de glisser hors de l'écran pendant la
     lecture sans redimensionner la page — un changement de hauteur de vue
     relancerait la mise en page du site à chaque geste. La WebView reçoit en
     compensation une vraie MARGE haute de la hauteur de la barre (posée dans
     le code, voir applyWebPadding) — une marge, pas un padding : elle réduit
     les bornes réelles de la WebView, pour qu'un en-tête de site en
     position:fixed/sticky (la norme pour la presse) ne puisse jamais être
     dessiné sous la barre et s'y retrouver recouvert. clipToPadding=false
     reste posé pour les côtés/le bas (barres système), où seul un padding
     est en jeu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg">

    <eu.lielu.news.ReaderWebView
        android:id="@+id/reader_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Page injoignable : plutôt qu'un écran noir, on dit ce qui se passe et
         on laisse deux issues (réessayer, ou passer au navigateur système —
         utile quand le site refuse la WebView). -->
    <LinearLayout
        android:id="@+id/reader_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/reader_bg"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reader_error"
            android:textSize="16sp"
            android:textColor="@color/reader_ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/reader_error_sub"
            android:textSize="13sp"
            android:textColor="@color/reader_muted" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reader_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reader_retry"
                android:textAllCaps="false"
                android:textColor="@color/reader_ink"
                android:background="@drawable/reader_button" />

            <Button
                android:id="@+id/reader_error_external"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/reader_external"
                android:textAllCaps="false"
                android:textColor="@color/reader_ink"
                android:background="@drawable/reader_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dernier enfant = au-dessus de tout le reste. Le bloc entier (barre +
         jauge) coulisse d'un seul tenant. -->
    <LinearLayout
        android:id="@+id/reader_barwrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@color/reader_bar">

        <LinearLayout
            android:id="@+id/reader_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/reader_close"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_reader_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reader_close" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/reader_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/reader_ink" />

                <TextView
                    android:id="@+id/reader_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="@color/reader_muted" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/reader_readmode"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_reader_read"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reader_readmode" />

            <ImageButton
                android:id="@+id/reader_share"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_reader_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reader_share" />

            <ImageButton
                android:id="@+id/reader_external"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_reader_external"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reader_external" />
        </LinearLayout>

        <!-- 2 dp, sans fond : le trait avance sur la barre, comme la jauge du fil. -->
        <ProgressBar
            android:id="@+id/reader_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/reader_progress" />
    </LinearLayout>

    <!-- Résumé local (ReaderSummary), habillé comme le reste de l'app : le bouton
         est celui du rail du fil (carré, liseré « redline »), la feuille celle
         des panneaux (« .sheet__panel » : fond « surface », coins de 8 dp en
         haut, poignée, voile noir à 78 %). Bouton en BAS à droite, là où tombe
         le pouce, petit et translucide pour ne pas gêner la lecture. Ces vues
         sont posées après la barre : au-dessus de tout.
         AUCUNE couleur ici : elles viennent de l'habillage actif de l'app
         (SummaryTheme), posé par ReaderSummary au démarrage. -->
    <ImageButton
        android:id="@+id/reader_summary_fab"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="36dp"
        android:padding="13dp"
        android:alpha="0.85"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_reader_summary"
        android:visibility="gone"
        android:contentDescription="@string/summary_fab" />

    <View
        android:id="@+id/reader_summary_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C7000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/reader_summary_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/reader_summary_grip"
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp" />

        <!-- Titre + lecture à voix haute (icône, facultative : visible seulement
             quand le résumé est fini, voir SummarySpeaker). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reader_summary_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/summary_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <ImageButton
                android:id="@+id/reader_summary_listen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_summary_speaker"
                android:contentDescription="@string/summary_listen"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Étiquette technique : la police à chasse fixe, capitales, cendre — le
             « .feedgroup summary » du panneau des sources. -->
        <TextView
            android:id="@+id/reader_summary_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:textSize="11sp" />

        <eu.lielu.news.MaxHeightScrollView
            android:id="@+id/reader_summary_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/reader_summary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.25"
                android:textIsSelectable="true" />
        </eu.lielu.news.MaxHeightScrollView>

        <ProgressBar
            android:id="@+id/reader_summary_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:visibility="gone" />

        <!-- Les actions sont tout en bas de la feuille : c'est là que le pouce
             tombe. La première est le bouton plein, les autres sont fantômes. -->
        <LinearLayout
            android:id="@+id/reader_summary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/reader_summary_btn1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/reader_summary_btn2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="46dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/reader_summary_btn3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="46dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
