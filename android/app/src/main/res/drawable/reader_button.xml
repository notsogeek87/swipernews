<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton de l'écran d'erreur : même pilule translucide que les boutons du fil. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#141420" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="100dp" />
    <padding
        android:left="18dp"
        android:top="10dp"
        android:right="18dp"
        android:bottom="10dp" />
</shape>
