<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille du résumé : celle des panneaux du fil (« .sheet__panel »). Fond
     « surface », coins de 8 dp en haut seulement, liseré « redline » sur trois
     côtés (le quatrième sort de l'écran), jamais d'ombre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sn_surface" />
            <stroke android:width="1dp" android:color="@color/sn_redline" />
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
