<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton fantôme d'une feuille (« .iobtn ») : transparent, liseré « redline »
     de 1,5 dp, coins de 4 dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26951C04">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="@color/sn_redline" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</ripple>
