<?xml version="1.0" encoding="utf-8"?>
<!-- Action principale d'une feuille : le bouton plein de l'app (« .card__open »),
     dégradé à 135 degrés, coins de 4 dp. « molten » vers « redline » plutôt que
     « surface » vers « molten » : sur le fond « surface » de la feuille, le
     premier se confondrait avec elle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F7F6FF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/sn_molten"
                android:endColor="@color/sn_redline" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</ripple>
