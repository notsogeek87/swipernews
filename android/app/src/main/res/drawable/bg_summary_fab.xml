<?xml version="1.0" encoding="utf-8"?>
<!-- Même bouton que le rail enregistrer/partager du fil (« .rail button » dans
     index.html) : carré aux coins de 4 dp, liseré « redline » de 1,5 dp, jamais
     d'ombre. Le fond est translucide : il garde l'icône lisible sur une page
     claire (mode lecture sépia ou clair) sans cacher le texte. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D951C04">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C190501" />
            <stroke android:width="1.5dp" android:color="@color/sn_redline" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</ripple>
